{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:famashines:the-vps:fees:ReverseChargeCommandPayloadV1",
  "title": "ReverseChargeCommandPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chargeId",
    "reason"
  ],
  "properties": {
    "chargeId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(.*\\S)?$"
    }
  }
}
