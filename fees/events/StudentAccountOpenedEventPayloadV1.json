{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:famashines:the-vps:fees:StudentAccountOpenedEventPayloadV1",
  "title": "StudentAccountOpenedEventPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "studentId",
    "enrollmentId",
    "academicYearId",
    "classId",
    "grade",
    "openedOn"
  ],
  "properties": {
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "studentId": {
      "type": "string",
      "format": "uuid"
    },
    "enrollmentId": {
      "type": "string",
      "format": "uuid"
    },
    "academicYearId": {
      "type": "string",
      "format": "uuid"
    },
    "classId": {
      "type": "string",
      "format": "uuid"
    },
    "grade": {
      "enum": [
        "playgroup",
        "kg-1",
        "kg-2",
        "class-1",
        "class-2",
        "class-3",
        "class-4",
        "class-5",
        "class-6",
        "class-7",
        "class-8",
        "class-9",
        "class-10"
      ]
    },
    "openedOn": {
      "type": "string",
      "format": "date"
    }
  }
}
