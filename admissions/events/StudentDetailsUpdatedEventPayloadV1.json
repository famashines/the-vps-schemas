{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:famashines:the-vps:admissions:StudentDetailsUpdatedEventPayloadV1",
  "title": "StudentDetailsUpdatedEventPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "studentId",
    "firstName",
    "lastName",
    "fatherName",
    "dateOfBirth",
    "gender",
    "guardian"
  ],
  "properties": {
    "studentId": {
      "type": "string",
      "format": "uuid"
    },
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "fatherName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "enum": [
        "female",
        "male"
      ]
    },
    "bFormNumber": {
      "type": "string",
      "pattern": "^[0-9]{5}-[0-9]{7}-[0-9]$"
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "familyStatus": {
      "enum": [
        "both-parents-alive",
        "father-deceased",
        "mother-deceased",
        "both-parents-deceased"
      ]
    },
    "familyStatusNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "siblings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "studentIds"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "studentIds": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "guardian": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "relation",
        "phone"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "relation": {
          "enum": [
            "father",
            "mother",
            "guardian"
          ]
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$"
        },
        "cnic": {
          "type": "string",
          "pattern": "^[0-9]{5}-[0-9]{7}-[0-9]$"
        }
      }
    }
  }
}
