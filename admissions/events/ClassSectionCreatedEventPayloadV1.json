{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:famashines:the-vps:admissions:ClassSectionCreatedEventPayloadV1",
  "title": "ClassSectionCreatedEventPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["classSectionId", "academicYearId", "grade", "section"],
  "properties": {
    "classSectionId": { "type": "string", "format": "uuid" },
    "academicYearId": { "type": "string", "format": "uuid" },
    "grade": { "enum": ["playgroup", "nursery", "prep", "class-1", "class-2", "class-3", "class-4", "class-5", "class-6", "class-7", "class-8", "class-9", "class-10"] },
    "section": { "type": "string", "minLength": 1, "maxLength": 20, "pattern": "^\\S(.*\\S)?$" }
  }
}
