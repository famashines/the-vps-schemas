{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:famashines:the-vps:admissions:MarkStudentLeftCommandPayloadV1",
  "title": "MarkStudentLeftCommandPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "studentId",
    "expectedVersion",
    "leftOn"
  ],
  "properties": {
    "studentId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 1
    },
    "leftOn": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(.*\\S)?$"
    }
  }
}
